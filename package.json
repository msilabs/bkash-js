{
  "name": "@msilabs/bkash",
  "version": "1.0.1",
  "description": "Server-side bKash Tokenized Checkout v2 client for Node, Bun, Deno and edge runtimes.",
  "license": "MIT",
  "author": "msisaif <msi313.bd@gmail.com>",
  "homepage": "https://github.com/msilabs/bkash-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msilabs/bkash-js.git"
  },
  "bugs": {
    "url": "https://github.com/msilabs/bkash-js/issues"
  },
  "keywords": [
    "bkash",
    "bangladesh",
    "payment",
    "tokenized-checkout",
    "payment-gateway",
    "typescript",
    "nodejs",
    "express",
    "nextjs",
    "hono",
    "cloudflare-workers",
    "bun",
    "deno"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
